# =========================================
# ME2U RAILWAY PRODUCTION CONFIGURATION
# =========================================
# Copy this to Railway Dashboard → Variables tab
# Replace all placeholders with real values
# =========================================

# DATABASE (Auto-configured by Railway - DO NOT CHANGE)
DATABASE_URL=${{Postgres.DATABASE_URL}}

# =========================================
# SECURITY - GENERATE RANDOM SECRET
# =========================================
# Generate at: https://generate-secret.vercel.app/32
# Or run: openssl rand -base64 32
AUTH_TOKEN_SECRET=<generate-a-random-32-char-secret>

# =========================================
# PAYSTACK - REQUIRED ⚠️
# =========================================
# Get from: https://dashboard.paystack.com/settings/api
# IMPORTANT: Use LIVE keys (sk_live_***, pk_live_***)
PAYSTACK_SECRET_KEY=sk_live_PASTE_YOUR_LIVE_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_live_PASTE_YOUR_LIVE_PUBLIC_KEY_HERE
PAYSTACK_DVA_ENABLED=true
PAYSTACK_DVA_PREFERRED_BANK=wema-bank

# =========================================
# EMAIL - REQUIRED ⚠️
# =========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM="Me2U" <noreply@me2ulend.online>

# =========================================
# BILLS PAYMENT - REQUIRED ⚠️
# =========================================
# Get from: https://www.vtpass.com
# Production URL (NOT sandbox)
VTPASS_BASE_URL=https://api.vtpass.com/api
VTPASS_PUBLIC_KEY=PASTE_YOUR_VTPASS_PUBLIC_KEY_HERE
VTPASS_SECRET_KEY=PASTE_YOUR_VTPASS_SECRET_KEY_HERE
VTPASS_API_KEY=PASTE_YOUR_VTPASS_API_KEY_HERE

# =========================================
# APP CONFIGURATION
# =========================================
# Update after Railway assigns your domain
NEXT_PUBLIC_APP_URL=https://me2ulend.online

# Platform bank account for wallet funding
NEXT_PUBLIC_PLATFORM_ACCOUNT_BANK=Wema Bank
NEXT_PUBLIC_PLATFORM_ACCOUNT_NAME=YOUR_COMPANY_NAME
NEXT_PUBLIC_PLATFORM_ACCOUNT_NUMBER=1234567890

# =========================================
# OPTIONAL SERVICES
# =========================================

# OpenAI Assistant (optional - leave empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=25000
OPENAI_MAX_OUTPUT_TOKENS=900
ASSISTANT_MAX_CONTEXT_SNIPPETS=6
ASSISTANT_DAILY_LIMIT=80

# Wema Bank API (keep disabled - use Paystack DVA instead)
WEMA_ENABLED=false
WEMA_BASE_URL=
WEMA_API_KEY=
WEMA_CLIENT_ID=
WEMA_AUTHORIZATION=
WEMA_WEBHOOK_SECRET=

# Flutterwave (backup - keep disabled)
FLUTTERWAVE_BILLS_ENABLED=false
FLUTTERWAVE_SECRET_KEY=

# =========================================
# PRODUCTION SETTINGS
# =========================================
ALLOW_DEMO_WALLET_FUNDING=false
NODE_ENV=production

# =========================================
# REDIS (Future scaling - not required yet)
# =========================================
# REDIS_URL=rediss://***REDACTED-USER:PASS***@redis.railway.internal:6379

# =========================================
# SMTP (Backup email - optional)
# =========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM="Me2U" <noreply@yourdomain.com>
