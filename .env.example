# =========================================
# ME2U LOCAL DEVELOPMENT CONFIGURATION
# =========================================
# Copy this to .env and fill in your values
# Using Railway PostgreSQL
# =========================================

# JWT Authentication Secret
# Generate: openssl rand -base64 32  or  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_TOKEN_SECRET=your-32-char-random-secret-here

# =========================================
# DATABASE - Railway PostgreSQL
# =========================================
# Production: Railway injects this from the Postgres service (postgres.railway.internal).
# Local development: create a public TCP proxy once, then use the proxied host/port:
#   railway tcp-proxy create --port 5432 --service Postgres
# It prints an endpoint such as tokaido.proxy.rlwy.net:47452 - use it below.
DATABASE_URL=postgresql://postgres:<password>@<proxy-host>:<proxy-port>/railway
PGSSLMODE=require

# =========================================
# SERVER CONFIGURATION
# =========================================
PORT=4000
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379

# =========================================
# PLATFORM ACCOUNT (for wallet funding)
# =========================================
NEXT_PUBLIC_PLATFORM_ACCOUNT_BANK=PREMIUM TRUST BANK
NEXT_PUBLIC_PLATFORM_ACCOUNT_NAME=YOUR_COMPANY_NAME
NEXT_PUBLIC_PLATFORM_ACCOUNT_NUMBER=0010245606

# Platform user ID for referral rewards (set after creating admin user)
PLATFORM_USER_ID=

# =========================================
# TRANSACTION PIN SECRET
# =========================================
# Used for HMAC-based transaction PIN verification
# Must be a secure random string (min 32 chars)
NIN_HASH_SECRET=your-secure-pin-secret-min-32-chars

# =========================================
# EMAIL - REQUIRED FOR OTP
# =========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Me2U" <noreply@yourdomain.com>

# SMTP Configuration (fallback - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password

# =========================================
# PAYSTACK - REQUIRED FOR WALLET FUNDING
# =========================================
# Get from: https://dashboard.paystack.com/settings/api
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PAYSTACK_DVA_ENABLED=false
PAYSTACK_DVA_PREFERRED_BANK=titan-paystack

# =========================================
# OPTIONAL SERVICES
# =========================================

# VTpass bills provider
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_PUBLIC_KEY=your-vtpass-public-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_API_KEY=your-vtpass-api-key

# Wema/ALAT banking (keep disabled until credentials ready)
WEMA_ENABLED=false
WEMA_TRANSFERS_ENABLED=false
WEMA_BASE_URL=
WEMA_API_KEY=
WEMA_CLIENT_ID=
WEMA_AUTHORIZATION=
WEMA_WEBHOOK_SECRET=

# Flaskwave (backup - keep disabled)
FLUTTERWAVE_BILLS_ENABLED=false
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key

# OpenAI Assistant (optional - leave empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=25000
OPENAI_MAX_OUTPUT_TOKENS=900
ASSISTANT_MAX_CONTEXT_SNIPPETS=6
ASSISTANT_DAILY_LIMIT=80

# =========================================
# APP CONFIGURATION
# =========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=admin@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# =========================================
# PRODUCTION SETTINGS
# =========================================
ALLOW_DEMO_WALLET_FUNDING=false
NODE_ENV=development
