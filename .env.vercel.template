# =========================================
# ME2U VERCEL PRODUCTION CONFIGURATION
# =========================================
# Add these in Vercel Dashboard → Settings → Environment Variables
# =========================================

# ==========================================
# DATABASE (Required)
# ==========================================
# Use Railway PostgreSQL or any PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:5432/database

# ==========================================
# SECURITY (Required)
# ==========================================
# Already generated: 67xFnPnEHBZcNDsA1Hx+4kr/TxeVzOCmnNCLW0xCci0=
AUTH_TOKEN_SECRET=67xFnPnEHBZcNDsA1Hx+4kr/TxeVzOCmnNCLW0xCci0=

# ==========================================
# EMAIL (SMTP - Required for OTP)
# ==========================================
# Option 1: Gmail (Free, no delays)
# 1. Enable 2FA: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use app password below (NOT your regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM="Me2U" <your-email@gmail.com>

# Option 2: Outlook/Hotmail (Free alternative)
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-outlook-password
# EMAIL_FROM="Me2U" <your-email@outlook.com>

# Option 3: Yahoo Mail
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@yahoo.com
# SMTP_PASSWORD=your-yahoo-app-password
# EMAIL_FROM="Me2U" <your-email@yahoo.com>

# ==========================================
# PAYSTACK (Required for payments)
# ==========================================
# Get from: https://dashboard.paystack.com/settings/api
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYSTACK_DVA_ENABLED=true
PAYSTACK_DVA_PREFERRED_BANK=wema-bank

# ==========================================
# BILLS PAYMENT (Optional - VTpass)
# ==========================================
# Leave empty to disable bills feature
# Get from: https://www.vtpass.com
VTPASS_BASE_URL=https://api.vtpass.com/api
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_API_KEY=

# ==========================================
# APP CONFIGURATION
# ==========================================
# Update after Vercel assigns your domain
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Platform bank account (for wallet funding)
NEXT_PUBLIC_PLATFORM_ACCOUNT_BANK=Your Bank Name
NEXT_PUBLIC_PLATFORM_ACCOUNT_NAME=YOUR COMPANY NAME
NEXT_PUBLIC_PLATFORM_ACCOUNT_NUMBER=1234567890

# ==========================================
# OPTIONAL SERVICES
# ==========================================
# OpenAI (leave empty to disable AI assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Wema Bank (leave disabled)
WEMA_ENABLED=false

# Flutterwave (leave disabled)
FLUTTERWAVE_BILLS_ENABLED=false

# ==========================================
# PRODUCTION FLAGS
# ==========================================
ALLOW_DEMO_WALLET_FUNDING=false
NODE_ENV=production
